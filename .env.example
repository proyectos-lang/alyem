# Supabase — proyecto del demo (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service role key (secreto, solo servidor). NO exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Esquema Postgres donde viven los datos y bucket de Storage para adjuntos.
SUPABASE_SCHEMA=aylem
SUPABASE_BUCKET=aylem
