# Supabase — proyecto del demo (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service role key (secreto, solo servidor). NO exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anon key PÚBLICA (Project Settings → API → anon public). Se usa solo en el
# navegador para las notificaciones en tiempo real (Realtime). Es segura de
# exponer. Sin ella, la campana sigue funcionando pero sin tiempo real.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Esquema Postgres donde viven los datos y bucket de Storage para adjuntos.
SUPABASE_SCHEMA=aylem
SUPABASE_BUCKET=aylem
